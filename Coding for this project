#include <Servo.h>
#include <LiquidCrystal.h>

// Initialize 16x2 LCD
// RS, E, D4, D5, D6, D7
LiquidCrystal lcd(12, 11, 5, 4, 6, 7);

// Pin definitions
const int trigPin = 2;
const int echoPin = 3;
const int buzzerPin = 8;
const int servoPin = 9;
const int ledPin = 10;

// Detection settings
const int alertThreshold = 100;  // 100 cm
const int minAngle = 15;
const int maxAngle = 165;
const int scanStep = 2;

// Tracking settings
const int trackingStep = 4;
const int maxMisses = 3;

Servo myServo;

// Scanning variables
int currentAngle = minAngle;
int scanDirection = 1;

// Tracking variables
int targetAngle = 90;
int previousTargetAngle = 90;
int missedReadings = 0;

bool tracking = false;

// Function declarations
int calculateDistance();
int readAtAngle(int angle);
void executeScan();
void trackObject();
void updateLCD(int angle, int distance);
void setAlert(bool active);

void setup() {

  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  pinMode(buzzerPin, OUTPUT);
  pinMode(ledPin, OUTPUT);

  Serial.begin(9600);

  myServo.attach(servoPin);
  myServo.write(currentAngle);

  lcd.begin(16, 2);

  lcd.setCursor(0, 0);
  lcd.print("Sonar Radar Sys");

  lcd.setCursor(0, 1);
  lcd.print("Initializing...");

  delay(1500);
  lcd.clear();

  setAlert(false);
}

void loop() {

  if (tracking == false) {

    executeScan();

  } else {

    trackObject();

  }
}

// =================================
// NORMAL SCANNING
// =================================

void executeScan() {

  // Move servo to current scanning angle
  myServo.write(currentAngle);
  delay(25);

  int distance = calculateDistance();

  // Display scanning information
  updateLCD(currentAngle, distance);

  // Send data to Serial Monitor
  Serial.print(currentAngle);
  Serial.print(",");
  Serial.println(distance);

  // Check for an object
  if (distance > 0 && distance <= alertThreshold) {

    tracking = true;

    targetAngle = currentAngle;
    previousTargetAngle = currentAngle;

    missedReadings = 0;

    setAlert(true);

    return;
  }

  setAlert(false);

  // Continue scanning
  currentAngle += scanDirection * scanStep;

  // Reverse at scanning limits
  if (currentAngle >= maxAngle) {

    currentAngle = maxAngle;
    scanDirection = -1;

  }

  if (currentAngle <= minAngle) {

    currentAngle = minAngle;
    scanDirection = 1;

  }
}

// =================================
// AUTOMATIC OBJECT TRACKING
// =================================

void trackObject() {

  int leftAngle = max(minAngle,
                      targetAngle - trackingStep);

  int rightAngle = min(maxAngle,
                       targetAngle + trackingStep);

  // Measure object at three nearby angles
  int centerDistance = readAtAngle(targetAngle);

  int leftDistance = readAtAngle(leftAngle);

  int rightDistance = readAtAngle(rightAngle);

  // Find the closest valid reading
  int bestDistance = 0;
  int bestAngle = targetAngle;

  if (centerDistance > 0 &&
      centerDistance <= alertThreshold) {

    bestDistance = centerDistance;
    bestAngle = targetAngle;
  }

  if (leftDistance > 0 &&
      leftDistance <= alertThreshold) {

    if (bestDistance == 0 ||
        leftDistance < bestDistance) {

      bestDistance = leftDistance;
      bestAngle = leftAngle;
    }
  }

  if (rightDistance > 0 &&
      rightDistance <= alertThreshold) {

    if (bestDistance == 0 ||
        rightDistance < bestDistance) {

      bestDistance = rightDistance;
      bestAngle = rightAngle;
    }
  }

  // Object found: adjust servo direction
  if (bestDistance > 0) {

    previousTargetAngle = targetAngle;

    targetAngle = bestAngle;

    myServo.write(targetAngle);

    missedReadings = 0;

    setAlert(true);

    updateLCD(targetAngle, bestDistance);

    Serial.print(targetAngle);
    Serial.print(",");
    Serial.println(bestDistance);

  }

  // Object temporarily lost
  else {

    missedReadings++;

    // Keep searching around the last known position
    if (missedReadings < maxMisses) {

      myServo.write(targetAngle);

      lcd.setCursor(0, 0);
      lcd.print("Tracking...     ");

      lcd.setCursor(0, 1);
      lcd.print("Searching...    ");

      delay(60);
    }

    // Resume normal scanning
    else {

      tracking = false;

      setAlert(false);

      currentAngle = targetAngle;

      // Continue scanning in the direction
      // the object was last moving
      if (targetAngle > previousTargetAngle) {
        scanDirection = 1;
      }
      else if (targetAngle < previousTargetAngle) {
        scanDirection = -1;
      }

      lcd.clear();

      lcd.print("Object Lost");

      delay(500);
    }
  }
}

// =================================
// MOVE SERVO AND MEASURE DISTANCE
// =================================

int readAtAngle(int angle) {

  myServo.write(angle);

  delay(40);

  return calculateDistance();
}

// =================================
// ULTRASONIC DISTANCE MEASUREMENT
// =================================

int calculateDistance() {

  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  // Timeout prevents long waiting
  unsigned long duration =
      pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) {
    return 0;
  }

  int distance = duration * 0.034 / 2;

  return distance;
}

// =================================
// BUZZER AND LED CONTROL
// =================================

void setAlert(bool active) {

  if (active) {

    digitalWrite(ledPin, HIGH);

    tone(buzzerPin, 2000);

  } else {

    digitalWrite(ledPin, LOW);

    noTone(buzzerPin);

  }
}

// =================================
// LCD DISPLAY
// =================================

void updateLCD(int angle, int distance) {

  lcd.setCursor(0, 0);

  lcd.print("Angle: ");
  lcd.print(angle);
  lcd.print(" deg   ");

  lcd.setCursor(0, 1);

  if (distance > 0 &&
      distance <= alertThreshold) {

    lcd.print("ALERT: ");
    lcd.print(distance);
    lcd.print(" cm   ");

  } else {

    lcd.print("Status: CLEAR   ");

  }
}
